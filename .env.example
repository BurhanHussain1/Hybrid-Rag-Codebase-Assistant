# Copy this file to ".env" and fill in your real key.
#   Windows (PowerShell):  Copy-Item .env.example .env
#   macOS / Linux:         cp .env.example .env
#
# Get a key at: https://platform.openai.com/api-keys
#
# This is the ONLY paid dependency. Embeddings and reranking run locally & free.
# Without a key the app still works in retrieval-only mode (no generated answer).

OPENAI_API_KEY=sk-your-key-here

# Optional: change the answer model in one place
OPENAI_MODEL=gpt-4o-mini
